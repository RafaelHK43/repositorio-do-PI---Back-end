# Variaveis de Ambiente - Sistema AC
# Copie este arquivo para .env e preencha com seus valores locais.

DB_PASSWORD=sua_senha_mysql

# E-mail usado pelo Spring Mail/Gmail.
EMAIL_USERNAME=seu_email@gmail.com

# Use uma senha de app do Gmail, nao a senha normal da conta.
# Gere em https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=sua_senha_de_app_gmail

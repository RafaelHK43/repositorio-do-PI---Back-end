# Variáveis de Ambiente - Sistema AC
# Copie este arquivo para .env e preencha com seus valores locais

# Credenciais do MySQL local
# Exemplo: MeuSQL@2025!
DB_PASSWORD=

# Senha de Aplicativo do Gmail (não use a senha da sua conta pessoal)
# Gere em https://myaccount.google.com/apppasswords
# Exemplo: lozzipibhpvwendb
EMAIL_PASSWORD=
